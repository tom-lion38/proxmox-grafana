        "type": "query",
        "name": "node",
        "label": "Nœud",
        "datasource": {
          "type": "influxdb",
          "uid": "${ds}"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"host\", predicate: (r) => r._measurement == \"cpustat\" and r.object == \"nodes\", start: -7d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"host\", predicate: (r) => r._measurement == \"cpustat\" and r.object == \"nodes\", start: -7d)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "options": [],
        "skipUrlSync": false,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "state-timeline",
      "title": "Nœuds en ligne",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"nodes\" and r._field == \"uptime\")\n  |> filter(fn: (r) => r.host =~ /^${node:regex}$/)\n  |> aggregateWindow(every: v.windowPeriod, fn: count, createEmpty: true)\n  |> duplicate(column: \"_value\", as: \"seen\")\n  |> cumulativeSum(columns: [\"seen\"])\n  |> filter(fn: (r) => r.seen > 0)\n  |> map(fn: (r) => ({_time: r._time, _value: if r._value > 0 then 1.0 else 0.0, node: r.host}))\n  |> group(columns: [\"node\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "En ligne",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Hors ligne",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "displayName": "${__field.labels.node}"
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "interval": "1m",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "state-timeline",
      "title": "VM et conteneurs en marche",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "import \"strings\"\nfrom(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and (r.object == \"qemu\" or r.object == \"lxc\") and r._field == \"status\")\n  |> filter(fn: (r) => r.nodename =~ /^${node:regex}$/)\n  |> map(fn: (r) => ({r with _value: if r._value == \"running\" then 1.0 else 0.0}))\n  |> aggregateWindow(every: v.windowPeriod, fn: min, createEmpty: true)\n  |> map(fn: (r) => ({_time: r._time, _value: r._value,\n      guest: strings.repeat(v: \" \", i: 10 - strings.strlen(v: r.vmid)) + r.vmid + \" \" + (if exists r.host then r.host else \"\")}))\n  |> group(columns: [\"guest\"])\n  |> sort(columns: [\"_time\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "En marche",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "Arrêté",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false,
            "insertNulls": false,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "displayName": "${__field.labels.guest}"
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "alignValue": "left",
        "rowHeight": 0.85,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "interval": "1m",
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 2
    },
    {
      "type": "table",
      "title": "Disponibilité sur la période",
      "description": "Part du temps passé en marche sur la période choisie en haut à droite.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "base = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"system\" and (r.object == \"qemu\" or r.object == \"lxc\") and r._field == \"status\")\n  |> filter(fn: (r) => r.nodename =~ /^${node:regex}$/)\nrunning = base\n  |> filter(fn: (r) => r._value == \"running\")\n  |> count()\n  |> group()\n  |> map(fn: (r) => ({r with _field: \"running\"}))\ntotal = base\n  |> count()\n  |> group()\n  |> map(fn: (r) => ({r with _field: \"total\"}))\nunion(tables: [running, total])\n  |> group()\n  |> pivot(rowKey: [\"object\", \"vmid\", \"nodename\", \"host\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n      type: if r.object == \"qemu\" then \"VM\" else \"CT\",\n      id: int(v: r.vmid),\n      name: r.host,\n      node: r.nodename,\n      availability: if exists r.running and r.total > 0 then float(v: r.running) / float(v: r.total) else 0.0}))\n  |> sort(columns: [\"availability\", \"id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false
          },
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "type"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Type"
              },
              {
                "id": "custom.width",
                "value": 60
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ID"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Proxmox - VM et conteneurs",
                    "url": "/d/pg-guest?var-guest=${__data.fields.id}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Nom"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Proxmox - VM et conteneurs",
                    "url": "/d/pg-guest?var-guest=${__data.fields.id}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "node"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Nœud"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "availability"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Disponibilité"
              },
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.95
                    },
                    {
                      "color": "green",
                      "value": 0.99
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": "",
          "countRows": false
        },
        "sortBy": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {},
            "indexByName": {
              "type": 0,
              "id": 1,
              "name": 2,
              "node": 3,
              "availability": 4
            }
          }
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 21
      },
      "id": 3
    }
  ]
