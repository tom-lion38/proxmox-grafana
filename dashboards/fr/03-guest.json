        "definition": "from(bucket: \"${bucket}\")\n  |> range(start: -7d)\n  |> filter(fn: (r) => r._measurement == \"system\" and (r.object == \"qemu\" or r.object == \"lxc\") and r._field == \"uptime\")\n  |> last()\n  |> group()\n  |> map(fn: (r) => ({_value: r.vmid + \" \" + (if exists r.host then r.host else \"\")}))",
